+#if OPENLOOP_NO_ENCODER
+/* open-loop state, motor-side radians */
+static volatile float openloop_target = 0.f;     // commanded by RPDO3 / demo
+static volatile float openloop_voltage = 0.f;    // commanded voltage amplitude
+static float openloop_angle = 0.f;               // slew-limited angle actually applied
+
+void MotorController_setOpenLoopCommand(MotorController *controller, float target, float voltage) {
+  // target is in position units (motor rad / gear_ratio), like position_target
+  openloop_target = target * controller->position_controller.gear_ratio;
+  openloop_voltage = clampf(voltage, 0.f, OPENLOOP_VOLTAGE_MAX);
+}
+
+float MotorController_getOpenLoopAngle(MotorController *controller) {
+  return openloop_angle / controller->position_controller.gear_ratio;
+}
+
+float MotorController_getPhaseCurrent(MotorController *controller) {
+  float i_alpha = controller->current_controller.i_alpha_measured;
+  float i_beta = controller->current_controller.i_beta_measured;
+  return sqrtf(i_alpha * i_alpha + i_beta * i_beta);
+}
+
+static void MotorController_updateOpenLoop(MotorController *controller) {
+  float max_step = OPENLOOP_SPEED_MAX / COMMUTATION_FREQ;
+  openloop_angle += clampf(openloop_target - openloop_angle, -max_step, max_step);
+  float voltage = openloop_voltage;
+  if (controller->powerstage.bus_voltage_measured < OPENLOOP_MIN_BUS_VOLTAGE) {
+    voltage = 0.f;
+  }
+  MotorController_setFluxAngle(controller, openloop_angle * (float)controller->motor.pole_pairs, voltage);
+}
+#endif
